DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55432/pizza
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55432/pizza_test
MONGO_URL=mongodb://localhost:27017
ARQ_REDIS_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6379
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Secret de signature dedie aux webhooks Stripe Connect (comptes connectes, direct
# charges) — different du secret plateforme ci-dessus, genere sur le Dashboard Stripe
# sous Developers -> Webhooks -> endpoint "Connect events" -> Signing secret.
# Laisser vide si Connect n'est pas encore configure : seul STRIPE_WEBHOOK_SECRET est tente.
STRIPE_WEBHOOK_CONNECT_SECRET=
JWT_SECRET=change-me-32-chars-minimum
# Cle dediee au HMAC de lookup des refresh tokens — separee de JWT_SECRET.
# Laisser vide pour retomber sur JWT_SECRET (comportement historique).
JWT_HMAC_SECRET=
ENVIRONMENT=local

# URL publique de base de l'API — utilisée pour construire les liens dans les emails
# (vérification d'adresse, reset de mot de passe). Laisser la valeur par défaut en local.
APP_BASE_URL=http://localhost:8000

# SMTP — envoi d'emails (vérification, reset de mot de passe, alertes stock).
# Laisser SMTP_HOST vide pour désactiver l'envoi (dégradation gracieuse, les emails
# sont alors seulement loggués au lieu d'être envoyés — utile en local/CI).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Sentry — APM + tracking d'erreurs. Laisser vide pour désactiver (local/CI).
SENTRY_DSN=

# CORS — origines autorisées (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# Cloudinary — stockage médias multi-tenant
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# APNs — notifications push iOS
# APNS_KEY_ID     : identifiant de la clé (10 caractères), visible dans Apple Developer → Keys
# APNS_TEAM_ID    : identifiant de l'équipe Apple (10 caractères), visible dans Membership
# APNS_BUNDLE_ID  : bundle ID de l'app iOS (ex: com.monentreprise.monapp)
# APNS_PRIVATE_KEY: contenu complet du fichier .p8 (PEM), sans les sauts de ligne
#                   → remplacer les \n par \\n pour tenir sur une seule ligne
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=

# FCM v1 — notifications push Android
# FCM_PROJECT_ID          : ID du projet Firebase (ex: mon-projet-12345)
# FCM_SERVICE_ACCOUNT_JSON: JSON string complet du service account Google
#                           téléchargé depuis Firebase Console → Project Settings → Service Accounts
#                           → "Generate new private key". Mettre le JSON sur une seule ligne.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Hub POS OAuth 2.0 — HubRise (https://www.hubrise.com/developers). Laisser
# POS_HUB_CLIENT_ID vide desactive la fonctionnalite ; AUTHORIZE_URL/TOKEN_URL
# ont deja les valeurs HubRise par defaut (settings.py) si non renseignees ici.
# Le client_secret sert aussi a signer/verifier les webhooks (X-HubRise-Hmac-SHA256)
# -- pas de secret webhook separe chez HubRise.
POS_HUB_PROVIDER_NAME=hubrise
POS_HUB_CLIENT_ID=
POS_HUB_CLIENT_SECRET=
POS_HUB_AUTHORIZE_URL=https://manager.hubrise.com/oauth2/v1/authorize
POS_HUB_TOKEN_URL=https://manager.hubrise.com/oauth2/v1/token
POS_HUB_API_BASE_URL=https://api.hubrise.com/v1
POS_HUB_REVOKE_URL=
POS_HUB_REDIRECT_URI=
POS_HUB_DEFAULT_SCOPES=
POS_HUB_ESTABLISHMENT_ID_FIELD=location_id
# Genere avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POS_TOKEN_ENCRYPTION_KEY=
POS_OAUTH_FRONTEND_RETURN_URL=

# Hub POS — synchronisation catalogue en cache local (voir
# docs/superpowers/specs/2026-08-11-hub-catalog-sync-design.md). Laisser
# POS_HUB_CATALOG_URL vide desactive la synchronisation (cron horaire, webhook et
# resynchronisation paresseuse deviennent des no-op), meme pattern que
# POS_HUB_CLIENT_ID ci-dessus. HubRise : https://api.hubrise.com/v1/catalogs/:id
# (:id = celui retourne a l'onboarding, pas un slug fixe a deviner ici).
POS_HUB_CATALOG_URL=
POS_HUB_CATALOG_RATE_LIMIT_PER_MINUTE=10
POS_HUB_SNAPSHOT_STALENESS_MINUTES=60
POS_HUB_SNAPSHOT_HARD_EXPIRY_HOURS=24
