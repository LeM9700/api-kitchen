msgstr "Votre commande #{order_id} est prête !"

#: app/modules/orders/service.py:1031 app/modules/orders/service.py:1033
#: app/modules/orders/service.py:1046 app/modules/orders/service.py:1069
#: app/modules/orders/service.py:1071
msgid "Order not found"
msgstr "Commande introuvable"

