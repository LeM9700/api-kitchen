#: app/core/email/resend_service.py:107 app/core/email/resend_service.py:126
msgid "Access suspended"
msgstr "Accès suspendu"

#: app/core/email/resend_service.py:108 app/core/email/resend_service.py:151
#: app/core/email/resend_service.py:195
msgid "Hello,"
msgstr "Bonjour,"

#: app/core/email/resend_service.py:110
#, python-brace-format
msgid ""
"Access to your restaurant {tenant_name} on the platform has been "
"temporarily suspended."
msgstr ""
"L'accès à votre restaurant {tenant_name} sur la plateforme a été suspendu"
" temporairement."

#: app/core/email/resend_service.py:116
msgid "Reason:"
msgstr "Raison :"

#: app/core/email/resend_service.py:118
msgid "For any questions, contact platform support by replying to this email."
msgstr ""
"Pour toute question, contactez le support plateforme en répondant à cet "
"email."

#: app/core/email/resend_service.py:120 app/core/email/resend_service.py:159
msgid "This email was sent automatically by the Pizza Platform."
msgstr "Cet email a été envoyé automatiquement par la plateforme Pizza Platform."

#: app/core/email/resend_service.py:150 app/core/email/resend_service.py:165
msgid "Access restored"
msgstr "Accès réactivé"

#: app/core/email/resend_service.py:153
#, python-brace-format
msgid ""
"Access to your restaurant {tenant_name} on the platform has been "
"restored. You can log in normally."
msgstr ""
"L'accès à votre restaurant {tenant_name} sur la plateforme a été "
"réactivé. Vous pouvez vous connecter normalement."

#: app/core/email/resend_service.py:194
msgid "Password reset"
msgstr "Réinitialisation de mot de passe"

#: app/core/email/resend_service.py:197
#, python-brace-format
msgid ""
"Your password for {tenant_name} has been reset by the platform "
"administrator."
msgstr ""
"Votre mot de passe pour {tenant_name} a été réinitialisé par "
"l'administrateur plateforme."

#: app/core/email/resend_service.py:203
msgid "Temporary password"
msgstr "Mot de passe temporaire"

#: app/core/email/resend_service.py:210
msgid "You will be asked to change this password on your next login."
msgstr "Vous serez invité à changer ce mot de passe à votre prochaine connexion."

#: app/core/email/resend_service.py:213
msgid "If you did not request this reset, contact support immediately."
msgstr ""
"Si vous n'avez pas demandé cette réinitialisation, contactez "
"immédiatement le support."

#: app/core/email/resend_service.py:219
msgid "New temporary password"
msgstr "Nouveau mot de passe temporaire"

#: app/modules/orders/service.py:896 app/modules/orders/service.py:1359
