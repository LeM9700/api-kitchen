msgstr "Seules les commandes en attente peuvent être annulées par le client"

#: app/modules/orders/service.py:1295
msgid "Your order has been cancelled"
msgstr "Votre commande a été annulée"

#: app/modules/orders/service.py:1296 app/modules/orders/service.py:1382
#, python-brace-format
msgid "Your order #{order_id} has been cancelled."
msgstr "Votre commande #{order_id} a été annulée."

#: app/modules/orders/service.py:1347
msgid "Order confirmed"
msgstr "Commande confirmée"

#: app/modules/orders/service.py:1348
#, python-brace-format
msgid "Your order #{order_id} has been confirmed."
msgstr "Votre commande #{order_id} a été confirmée."

#: app/modules/orders/service.py:1353
msgid "Being prepared"
msgstr "En préparation"

#: app/modules/orders/service.py:1354
#, python-brace-format
msgid "Your order #{order_id} is being prepared."
msgstr "Votre commande #{order_id} est en cours de préparation."

#: app/modules/orders/service.py:1365 app/modules/orders/service.py:1371
